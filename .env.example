# Frontend -> local fullstack BFF
VITE_REMOTE_AUTH=true
# Leave blank in local development to use the Vite /api proxy.
VITE_API_BASE_URL=
VITE_EXPLAINER_API_URL=

# BFF
APP_ORIGIN=http://localhost:5173
API_PORT=4100
NODE_ENV=development
SESSION_TTL_HOURS=8

# Optional AI explainer. Authentication and the rest of the app work without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Optional runtime rollout overrides
VITE_FLAG_SAVED_VIEWS=true
VITE_FLAG_RISK_EXPLAINABILITY=true
VITE_FLAG_PORTFOLIO_COMPARE=false
VITE_FLAG_EXPLAINER=true
