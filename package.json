{
  "private": true,
  "version": "1.0.0",
  "author": "Deniz Aslaner",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx tools/server.ts",
    "build": "npm run typecheck && npm run build:production",
    "build:app": "vite build",
    "build:server": "esbuild tools/server.ts --bundle --platform=node --format=esm --target=node24 --outfile=server-dist/server.mjs",
    "build:production": "npm run build:app && npm run build:server",
    "preview": "vite preview",
    "serve:production": "node server-dist/server.mjs",
    "server": "tsx tools/server.ts",
    "explainer": "tsx tools/server.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run src/components/AppHeader.a11y.test.tsx src/components/CompanyDetailAnalytics.a11y.test.tsx",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build:production && npm run build-storybook",
    "verify:ci": "npm run lint && npm run typecheck && npm run test:coverage",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:e2e:local": "npm run build:production && npm run test:e2e"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "openai": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.0.1",
    "storybook": "^10.5.6",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "^8.3.0",
    "vitest": "4.1.10"
  },
  "name": "companyscope-product",
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
